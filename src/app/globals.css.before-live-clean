}

.tech-stars-flow {
  position: absolute;
  inset: -20%;
  background-image: radial-gradient(circle, rgba(255,255,255,.9) 0 1px, transparent 1.7px);
  background-size: 110px 110px;
  opacity: .12;
  animation: techStarsFlow 30s linear infinite;
}

.tech-data-lines {
  position: absolute;
  inset: 0;
  pointer-events: none;
  overflow: hidden;
}

.tech-data-lines span {
  position: absolute;
  left: 38%;
  width: 44vw;
  height: 2px;
  background: linear-gradient(90deg, transparent, rgba(56,189,248,.95), rgba(168,85,247,.75), transparent);
  filter: drop-shadow(0 0 14px rgba(56,189,248,.8));
  opacity: .52;
  animation: techDataFlow 3.8s linear infinite;
}

.tech-data-lines span:nth-child(1) { top: 38%; animation-delay: 0s; }
.tech-data-lines span:nth-child(2) { top: 47%; animation-delay: -.9s; }
.tech-data-lines span:nth-child(3) { top: 56%; animation-delay: -1.8s; }
.tech-data-lines span:nth-child(4) { top: 65%; animation-delay: -2.7s; }

.tech-text {
  position: absolute;
  left: 6vw;
  top: 50%;
  transform: translateY(-50%);
  z-index: 5;
  max-width: 560px;
}

.tech-text p {
  margin: 0 0 30px;
  color: #22d3ee;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: .48em;
}

.tech-text h2 {
  margin: 0;
  font-size: clamp(3.2rem, 5vw, 6rem);
  line-height: .96;
  letter-spacing: -.06em;
  font-weight: 950;
}

.tech-text h2 span {
  background: linear-gradient(90deg, #22d3ee, #3b82f6, #a855f7);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.tech-text h3 {
  margin: 34px 0 0;
  color: rgba(255,255,255,.68);
  font-size: 18px;
  line-height: 1.85;
  font-weight: 400;
}

.tech-mini-cards {
  position: absolute;
  right: 48px;
  top: 50%;
  transform: translateY(-50%);
  z-index: 6;
  display: grid;
  grid-template-columns: repeat(2, 230px);
  gap: 18px;
}

.tech-mini-cards article {
  min-height: 132px;
  padding: 24px;
  border-radius: 22px;
  border: 1px solid rgba(56,189,248,.22);
  background: rgba(0,0,0,.48);
  backdrop-filter: blur(18px);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.06), 0 24px 70px rgba(0,0,0,.28);
  transition: .25s ease;
}

.tech-mini-cards article:hover {
  transform: translateY(-5px);
  border-color: rgba(103,232,249,.62);
  box-shadow: 0 0 48px rgba(56,189,248,.16);
}

.tech-mini-cards strong {
  display: block;
  font-size: 25px;
  font-weight: 950;
}

.tech-mini-cards small {
  display: block;
  margin-top: 10px;
  color: rgba(255,255,255,.6);
  font-size: 14px;
}

@keyframes techFiberFloat {
  0%,100% { transform: translateX(0) scale(1); }
  50% { transform: translateX(-18px) scale(1.025); }
}

@keyframes techStarsFlow {
  from { background-position: 0 0; }
  to { background-position: -330px 240px; }
}

@keyframes techDataFlow {
  from { transform: translateX(-120%); opacity: 0; }
  20% { opacity: .7; }
  80% { opacity: .7; }
  to { transform: translateX(120%); opacity: 0; }
}

