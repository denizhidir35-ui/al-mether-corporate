@import "tailwindcss";

* { box-sizing: border-box; }

html,
body {
  margin: 0;
  min-height: 100%;
  background: black;
  color: white;
  overflow-x: hidden;
}

body {
  font-family: Arial, Helvetica, sans-serif;
}

a,
button {
  font: inherit;
}

.hero-video {
  transform: translateX(-60px) scale(1.05) !important;
  filter: contrast(1.12) saturate(1.14) brightness(1.02);
}

.topbar-soft,
.right-socialbar {
  box-shadow:
    inset 0 1px 0 rgba(255,255,255,.08),
    0 18px 80px rgba(0,0,0,.38);
}

.right-socialbar {
  position: absolute;
  right: 6px;
  top: 150px;
  bottom: 58px;
  width: 150px;
  z-index: 9999;
  display: none;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,.12);
  background: rgba(3,5,14,.92);
  backdrop-filter: blur(26px);
}

.social-inner {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 22px;
}

.social-label {
  font-size: 11px;
  font-weight: 800;
  letter-spacing: .42em;
  color: rgba(255,255,255,.65);
}

.social-line {
  width: 1px;
  height: 34px;
  background: rgba(255,255,255,.28);
}

.right-socialbar a {
  display: grid;
  width: 46px;
  height: 46px;
  place-items: center;
  border-radius: 999px;
  border: 1px solid rgba(255,255,255,.18);
  color: rgba(255,255,255,.86);
  font-size: 13px;
  font-weight: 800;
  text-decoration: none;
}

@media (min-width: 1024px) {
  .right-socialbar {
    display: block;
  }
}

.mether-hero {
  animation: heroEnter 1.15s ease-out both;
}

.hero-stage {
  position: absolute;
  inset: 0;
  transform: translate3d(calc(-60px + var(--mx)), var(--my), 0) scale(1.05);
  transition: transform .18s ease-out;
  will-change: transform;
}

.hero-video {
  filter: contrast(1.12) saturate(1.14) brightness(1.02);
}

.hero-cinema-fade {
  pointer-events: none;
  position: absolute;
  inset: 0;
  z-index: 5;
  background: radial-gradient(circle at 55% 42%, transparent 0%, rgba(0,0,0,.03) 42%, rgba(0,0,0,.16) 100%);
  animation: cinemaFade 1.4s ease-out both;
}

.hero-cta-zone {
  position: absolute;
  z-index: 50;
  top: 69.5%;
  height: 76px;
  border-radius: 999px;
  transition: box-shadow .25s ease, transform .25s ease, background .25s ease;
}

.hero-cta-primary {
  left: 3.2%;
  width: 310px;
}

.hero-cta-secondary {
  left: 20.2%;
  width: 250px;
}

.hero-cta-zone:hover {
  transform: translateY(-2px) scale(1.015);
  box-shadow:
    0 0 38px rgba(56,189,248,.36),
    0 0 70px rgba(168,85,247,.24);
  background: rgba(255,255,255,.025);
}

.right-socialbar svg {
  width: 19px;
  height: 19px;
  fill: currentColor;
}

.right-socialbar a {
  transition: transform .22s ease, border-color .22s ease, color .22s ease, box-shadow .22s ease;
}

.right-socialbar a:hover {
  transform: translateY(-2px) scale(1.08);
  color: #ffffff;
  border-color: rgba(103,232,249,.55);
  box-shadow:
    0 0 22px rgba(56,189,248,.2),
    inset 0 0 18px rgba(255,255,255,.04);
}

@keyframes heroEnter {
  from {
    opacity: 0;
    filter: blur(14px);
  }
  to {
    opacity: 1;
    filter: blur(0);
  }
}

@keyframes cinemaFade {
  from {
    opacity: .85;
    background: #000;
  }
  to {
    opacity: 1;
  }
}

.hero-stage {
  transform: none !important;
}

.hero-video {
  transform: translateX(-60px) scale(1.05) !important;
}

.mether-core {
  position: relative;
  min-height: 100vh;
  overflow: hidden;
  background:
    radial-gradient(circle at 72% 28%, rgba(139,92,246,.18), transparent 34%),
    radial-gradient(circle at 20% 72%, rgba(34,211,238,.14), transparent 32%),
    #02040a;
  color: white;
}

.core-watermark {
  position: absolute;
  inset: 0;
  display: grid;
  place-items: center;
  font-size: clamp(6rem, 18vw, 20rem);
  font-weight: 950;
  letter-spacing: -.08em;
  color: rgba(255,255,255,.045);
  pointer-events: none;
  user-select: none;
}

.core-content {
  position: relative;
  z-index: 5;
  min-height: 100vh;
  display: grid;
  grid-template-columns: 1fr 520px;
  gap: 80px;
  align-items: center;
  padding: 120px 8vw;
}

.core-kicker {
  margin-bottom: 28px;
  font-size: 13px;
  font-weight: 900;
  letter-spacing: .48em;
  color: #67e8f9;
}

.core-left h2 {
  margin: 0;
  max-width: 760px;
  font-size: clamp(4rem, 7vw, 8rem);
  line-height: .92;
  letter-spacing: -.075em;
  font-weight: 950;
}

.core-left h2 span {
  display: block;
  background: linear-gradient(90deg, #67e8f9, #3b82f6, #a855f7);
  -webkit-background-clip: text;
  background-clip: text;
  color: transparent;
}

.core-desc {
  margin-top: 34px;
  max-width: 620px;
  font-size: 19px;
  line-height: 1.9;
  color: rgba(255,255,255,.62);
}

.core-cards {
  display: grid;
  gap: 18px;
}

.core-card {
  position: relative;
  overflow: hidden;
  min-height: 112px;
  padding: 26px 28px;
  border-radius: 28px;
  border: 1px solid rgba(255,255,255,.12);
  background: rgba(255,255,255,.045);
  backdrop-filter: blur(22px);
  box-shadow: inset 0 1px 0 rgba(255,255,255,.08), 0 28px 80px rgba(0,0,0,.25);
  animation: coreCardIn .8s ease both;
}

.core-card::before {
  content: "";
  position: absolute;
  inset: -1px;
  background: linear-gradient(120deg, rgba(34,211,238,.24), transparent 45%, rgba(168,85,247,.22));
  opacity: 0;
  transition: opacity .25s ease;
}

.core-card:hover::before {
  opacity: 1;
}

.core-card:hover {
  transform: translateY(-3px);
  border-color: rgba(103,232,249,.34);
}

.core-card span {
  position: relative;
  display: block;
  font-size: 26px;
  font-weight: 950;
  letter-spacing: -.03em;
}

.core-card p {
  position: relative;
  margin: 8px 0 0;
  color: rgba(255,255,255,.55);
  font-size: 14px;
}

.core-stars {
  position: absolute;
  inset: -20%;
  background-image:
    radial-gradient(circle, rgba(255,255,255,.8) 0 1px, transparent 1.5px);
  background-size: 90px 90px;
  opacity: .18;
}

.core-stars-a {
  animation: starsMoveA 28s linear infinite;
}

.core-stars-b {
  background-size: 140px 140px;
  opacity: .12;
  animation: starsMoveB 42s linear infinite;
}

.core-nebula {
  position: absolute;
  width: 48vw;
  height: 48vw;
  border-radius: 999px;
  filter: blur(70px);
  opacity: .22;
}

.core-nebula-a {
  right: -12vw;
  top: 8vh;
  background: #8b5cf6;
  animation: nebulaFloat 18s ease-in-out infinite alternate;
}

.core-nebula-b {
  left: -18vw;
  bottom: 4vh;
  background: #06b6d4;
  animation: nebulaFloat 22s ease-in-out infinite alternate-reverse;
}

@keyframes starsMoveA {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(-90px, 90px, 0); }
}

@keyframes starsMoveB {
  from { transform: translate3d(0, 0, 0); }
  to { transform: translate3d(140px, -140px, 0); }
}

@keyframes nebulaFloat {
  from { transform: translate3d(0, 0, 0) scale(1); }
  to { transform: translate3d(40px, -28px, 0) scale(1.08); }
}

@keyframes coreCardIn {
  from {
    opacity: 0;
    transform: translateY(28px);
  }
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@media (max-width: 1023px) {
  .core-content {
    grid-template-columns: 1fr;
    padding: 100px 24px;
  }

  .core-cards {
    max-width: 560px;
  }
}

